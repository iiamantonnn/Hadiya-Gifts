# Defaults to a local SQLite file - zero setup needed to run this. Point at
# a Postgres/Neon connection string in production (a normal postgres://
# connection via SQLAlchemy - never a provider's HTTP/serverless API).
DATABASE_URL=sqlite:///./hadiya.db

# Generate a long random string for any real environment.
JWT_SECRET=change-me-in-every-real-environment

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# WebAuthn (passkeys) - rp_id must match the domain serving the frontend
# (no scheme, no port - "localhost" in dev, "hadiya.app" in production).
# origin must be the exact scheme+host+port the browser sees.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Hadiya
WEBAUTHN_ORIGIN=http://localhost:5173

# Optional. Without this, the AI assistant and AI-generated card messages
# use a working rule-based fallback instead - the app is fully functional
# either way. Get a key from https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash
